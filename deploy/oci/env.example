# Copy this file to /opt/fayanms/.env on the OCI host and chmod 600 it.
# Never commit the copied file. Every image reference must be an immutable
# commit-SHA tag produced by the GHCR workflow.

FAYANMS_IMAGE=ghcr.io/fayafatehi/fayanms:REPLACE_WITH_FULL_COMMIT_SHA
FAYANMS_WORKER_IMAGE=ghcr.io/fayafatehi/fayanms-worker:REPLACE_WITH_FULL_COMMIT_SHA
FAYANMS_MIGRATOR_IMAGE=ghcr.io/fayafatehi/fayanms-migrator:REPLACE_WITH_FULL_COMMIT_SHA

FAYANMS_TLS_DOMAIN=nms-staging.example.com
NEXT_PUBLIC_SITE_URL=https://nms-staging.example.com
NEXTAUTH_URL=https://nms-staging.example.com

POSTGRES_PASSWORD=SET_ON_HOST_ONLY
DATABASE_URL=postgresql://fayanms:SET_ON_HOST_ONLY@postgres:5432/fayanms

NEXTAUTH_SECRET=SET_ON_HOST_ONLY
FAYANMS_SERVICE_SECRET=SET_ON_HOST_ONLY
FAYANMS_CONFIG_ENC_KEY=SET_64_HEX_CHARS_ON_HOST_ONLY
FAYANMS_CONFIG_ENC_KEY_ID=oci-staging-k1

# Worker-side identity and vault references. Keep device secret values outside
# Git and resolve them on the worker using the repository's secretRef contract.
FAYANMS_SERVICE_PRIVATE_KEY=SET_ON_HOST_ONLY
FAYANMS_SERVICE_PUBLIC_KEYS=SET_ON_HOST_ONLY
FAYANMS_VAULT_PROVIDER=SET_ON_HOST_ONLY
FAYANMS_TRUST_PROXY_HOPS=1
# Optional bearer token for internal Prometheus scraping. Never expose it in
# public URLs or logs; configure Prometheus credentials_file when enabled.
FAYANMS_METRICS_TOKEN=SET_ON_HOST_ONLY

# Optional operator controls. Defaults are conservative.
FAYANMS_HTTP_PORT=80
FAYANMS_HTTPS_PORT=443
FAYANMS_BACKUP_DIR=/opt/fayanms/backups
