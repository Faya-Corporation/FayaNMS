{
  "name": "fayanms",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "case \"${DATABASE_URL:-}\" in postgres://* | postgresql://*) ;; *) export DATABASE_URL=\"postgresql://fayanms:fayanms@localhost:5433/fayanms\" ;; esac; next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:gate": "bun run build",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "lint": "eslint .",
    "test": "bun test tests/",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "keys:service": "bun scripts/generate-service-keys.ts",
    "db:reset": "prisma migrate reset",
    "brand:validate": "bun scripts/validate-brand-assets.ts",
    "brand:validate-icons": "bun scripts/validate-icon-registry.ts",
    "brand:raster": "bun scripts/generate-brand-raster-assets.ts",
    "brand:validate-consumers": "bun scripts/validate-brand-consumers.ts",
    "brand:audit": "bun run brand:validate && bun run brand:validate-icons && bun run brand:validate-consumers",
    "demo:fleet": "bun scripts/demo-fleet-probe.ts"
  },
  "dependencies": {
