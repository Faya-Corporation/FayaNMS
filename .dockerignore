# FayaNMS Docker build context guard (T1b of
# docs/deploy/WINDOWS-SERVER-DOCKER-DESKTOP.md).
#
# Goal: context stays in the tens-of-MB range and NOTHING secret or volatile
# ever enters an image layer (docker history / image export must show no .env*,
# no database, no logs). Both the app build (Dockerfile) and the worker build
# (Dockerfile.worker) share this context root.

# dependencies / build output (installed fresh inside the stages)
# NOTE the ** form: a bare "node_modules" matches only the top level, which
# would still let mini-services/worker/node_modules enter the context (Phase
# 22 lesson — the worker now carries its own node_modules with ssh2).
**/node_modules
.next
out
build

# VCS + CI
.git
.github

# Local deployment checkout and workstation-only helpers are not image inputs.
FAYA-NMS-Main
Deploy-FayaNMS.ps1
*.code-workspace

# runtime state — NEVER bake these into an image (P19-REP lesson: the live DB
# churned 475 MB of git history once; it does not get to poison images too)
db
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# secrets + env — env comes ONLY from compose env_file / --env-file
.env*
!.env.example

# logs / scratch / session artifacts
*.log
*.out
*.pid
dev.log
server.log
upload
download
.scratch
agent-ctx
tool-results
.zscripts
.z-ai-config
.claude

# docs / tests / examples — not needed by any build stage (the seed ships via
# prisma/, the worker via mini-services/worker/)
docs
tests
examples
skills
worklog.md

# test-only TLS fixture material (R73, run 35417127704) — the committed
# self-signed loopback SFOS harness keys (harness/tls/, regen documented in
# mini-services/worker/harness/tls/README.md) are P1-019 non-authority test
# material and must never enter an image layer, per this file's stated goal.
# SAFE for the worker runtime: harness/sfos-webapi.ts reads the PEMs lazily
# inside startSfosWebApiHarness() (never at module load), so worker boot and
# every runtime plane are unaffected; the only impacted path is the SFOS
# certify flavor executed INSIDE the Docker runtime image, which now fails
# typed at call time — the certify driver of record runs in the CI gate job
# where the checkout carries the fixtures. Worker image scan (trivy,
# HIGH/CRITICAL, exit 1) passes for the same reason the fixture is gone.
mini-services/worker/harness/tls
