# Migration-only image. It contains Prisma CLI and committed migration files,
# not the application source, credentials, or runtime server.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS deps
WORKDIR /migrator

COPY package.json bun.lock ./
COPY prisma ./prisma
# GA-6: production-only install — the migrator needs ONLY the prisma CLI
# chain (a production dependency) and its engines. The full install dragged
# the devDependency chain (eslint → micromatch → braces) into the image,
# where trivy blocks on CVE-2026-93687 (braces, HIGH — NO upstream fixed
# version). Dropping devDependencies removes the package from the image
# instead of ignoring the CVE — a smaller image and no allowlist rot.
RUN bun install --frozen-lockfile --production
COPY scripts/ci/prepare-prisma-runtime.sh /usr/local/bin/prepare-prisma-runtime.sh
RUN chmod 0755 /usr/local/bin/prepare-prisma-runtime.sh \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libgcc-s1 openssl \
 && rm -rf /var/lib/apt/lists/*
RUN /usr/local/bin/prepare-prisma-runtime.sh /migrator /prisma-runtime

FROM oven/bun:1.3.14-distroless@sha256:c28c51287af70bab8e0b66fc4b6a30cfb92a727ebc88045223adc9f4c9d09307 AS runtime
ARG FAYANMS_SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision="${FAYANMS_SOURCE_SHA}"
WORKDIR /migrator
COPY --from=deps --chown=10001:10001 /migrator/ ./
COPY --from=deps --chown=10001:10001 /prisma-runtime ./prisma-runtime
COPY --from=deps --chown=10001:10001 /prisma-runtime/lib/libssl.so.3 /usr/lib/libssl.so.3
COPY --from=deps --chown=10001:10001 /prisma-runtime/lib/libcrypto.so.3 /usr/lib/libcrypto.so.3

ENV NODE_ENV=production \
    PATH=/migrator/prisma-runtime/bin:/usr/local/bin:/usr/bin:/bin \
    LD_LIBRARY_PATH=/migrator/prisma-runtime/lib
USER 10001
ENTRYPOINT ["/usr/local/bin/bun"]
CMD ["run", "./node_modules/prisma/build/index.js", "migrate", "deploy"]
