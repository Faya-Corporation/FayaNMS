# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS worker mini-service image — T2 of
# docs/deploy/WINDOWS-SERVER-DOCKER-DESKTOP.md.
#
# Topology (T5, 2026-09-13): own container on the compose bridge network —
# service DNS names (`worker` / `app`); no network-namespace sharing.
#
# Runtime dependency: ssh2 (Phase 22 slice 1 — the LIVE_SSH read-only device
# plane). The install is lockfile-frozen (mini-services/worker/bun.lock,
# committed). Worker-side SECRETS (LIVE_SSH vault entries, FAYANMS_VAULT_*)
# arrive via the compose env_file — never baked into the image.
#
# Port 3030 is backend-to-backend BY CONTRACT and must never be published.
# The worker NEVER touches the database — all persistence flows through the
# app's API (NEXT_BASE_URL).
# ─────────────────────────────────────────────────────────────────────────────

# SUPPLY-001-A: digest-pinned base (see Dockerfile for the bump procedure).
FROM oven/bun:1.3.14-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04
WORKDIR /worker
# R78 (run 35423693016): same base → same Debian-package findings as the app
# image (88 HIGH/CRITICAL at the first image scan — fixes published to the
# Debian security channel AFTER the base was built; the pinned digest is the
# current tag resolution, verified against the registry). Track the security
# channel; lists dropped so no stale index ships in the image.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY mini-services/worker/package.json mini-services/worker/bun.lock ./
# --omit dev: @types/ssh2 is compile-time only. --omit optional: skips ssh2's
# cpu-features/nan native helpers (they node-gyp-build on install — the slim
# image has no toolchain, they are try/catch optional at runtime, and keeping
# them out also keeps their vendored test Dockerfiles out of the image).
RUN bun install --frozen-lockfile --omit dev --omit optional
COPY --chown=bun:bun mini-services/worker/ .
USER bun
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:3030/health"); process.exit(r.ok ? 0 : 1)'
CMD ["bun", "index.ts"]
