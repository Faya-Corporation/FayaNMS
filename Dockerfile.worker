# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS worker mini-service image — T2 of
# docs/deploy/WINDOWS-SERVER-DOCKER-DESKTOP.md.
#
# Topology (T5, 2026-09-13): own container on the compose bridge network —
# service DNS names (`worker` / `app`); no network-namespace sharing.
#
# Runtime dependency: ssh2 (Phase 22 slice 1 — the LIVE_SSH read-only device
# plane). The install is lockfile-frozen (mini-services/worker/bun.lock,
# committed). Worker-side SECRETS (LIVE_SSH vault entries, FAYANMS_VAULT_*)
# arrive via the compose env_file — never baked into the image.
#
# Port 3030 is backend-to-backend BY CONTRACT and must never be published.
# The worker NEVER touches the database — all persistence flows through the
# app's API (NEXT_BASE_URL).
# ─────────────────────────────────────────────────────────────────────────────

# SUPPLY-001-A: digest-pinned base (see Dockerfile for the bump procedure).
FROM oven/bun:1.3.14-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04 AS deps
WORKDIR /worker
# Package installation stays in the build stage; the final runtime is distroless.
COPY mini-services/worker/package.json mini-services/worker/bun.lock ./
# --omit dev: @types/ssh2 is compile-time only. --omit optional: skips ssh2's
# cpu-features/nan native helpers (they node-gyp-build on install — the slim
# image has no toolchain, they are try/catch optional at runtime, and keeping
# them out also keeps their vendored test Dockerfiles out of the image).
RUN bun install --frozen-lockfile --omit dev --omit optional
COPY --chown=bun:bun mini-services/worker/ .
# Shared protocol modules are runtime imports of the worker, not build-only files.
# Copy them explicitly so the distroless image cannot pass build and fail on first poll.

FROM oven/bun:1.3.14-distroless@sha256:c28c51287af70bab8e0b66fc4b6a30cfb92a727ebc88045223adc9f4c9d09307 AS runtime
ARG FAYANMS_SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision="${FAYANMS_SOURCE_SHA}"
WORKDIR /worker
COPY --from=deps --chown=10001:10001 /worker/ ./
COPY --chown=10001:10001 scripts/protocol-lab/snmpv3.ts /scripts/protocol-lab/snmpv3.ts
COPY --chown=10001:10001 src/lib/protocol/snmpv3-policy.ts /src/lib/protocol/snmpv3-policy.ts
COPY --chown=10001:10001 src/lib/protocol/ingest.ts /src/lib/protocol/ingest.ts
COPY --chown=10001:10001 src/lib/protocol/netflow-v5.ts /src/lib/protocol/netflow-v5.ts
# Shared policy modules are runtime imports of the worker (F-038: the discovery
# policy imports its sibling classifier — the COPY pair is pinned by tests).
COPY --chown=10001:10001 src/lib/net/target-policy.ts /src/lib/net/target-policy.ts
COPY --chown=10001:10001 src/lib/discovery/policy.ts /src/lib/discovery/policy.ts
USER 10001
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/usr/local/bin/bun", "-e", "const r = await fetch('http://127.0.0.1:3030/health'); process.exit(r.ok ? 0 : 1)"]
ENTRYPOINT ["/usr/local/bin/bun"]
CMD ["index.ts"]
