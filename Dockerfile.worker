# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS worker mini-service image — T2 of
# docs/deploy/WINDOWS-SERVER-DOCKER-DESKTOP.md.
#
# Zero-dependency bun service. Port 3030 is backend-to-backend BY CONTRACT and
# must never be published. In compose it joins the app's network namespace
# (network_mode: "service:app") so both hardcoded loopback contracts hold:
#   app    → http://localhost:3030 (this service's HTTP surface)
#   worker → http://localhost:3000 (Next.js persistence API)
# Never touches SQLite — all persistence flows through the app's API.
# ─────────────────────────────────────────────────────────────────────────────

FROM oven/bun:1.3.14-slim
WORKDIR /worker
COPY mini-services/worker/package.json ./
RUN bun install
COPY --chown=bun:bun mini-services/worker/ .
USER bun
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:3030/health"); process.exit(r.ok ? 0 : 1)'
CMD ["bun", "index.ts"]
