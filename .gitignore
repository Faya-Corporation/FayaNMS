!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/
*.pem
# CERT-006: committed TEST-ONLY harness TLS material (loopback SFOS WebAPI
# harness certificate — never production material; see
# mini-services/worker/harness/tls/README.md)
!mini-services/worker/harness/tls/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# tool artifacts (orchestrator/agent session outputs)
tool-results/
!.env.example

# ── repository-size guard (2026-09-10 size audit: remote served 95.77 MiB before
#    the history purge; live db + WAL snapshots were the root cause) ──
# runtime SQLite — the live database and its WAL/SHM sidecars churn on every
# run (24 committed versions once totalled 475 MB of history). Rebuild via
# `bun run db:push` + the seed; NEVER commit db artifacts again (P19-REP).
/db/*.db
/db/*.db-shm
/db/*.db-wal
/db/*.db-journal
/db/*.sqlite
/db/*.sqlite3

# Embedded PostgreSQL (Phase 21 sandbox dev database — binaries + cluster).
# NEVER tracked: portable engine binaries and the dev cluster's data files.
/db/pg-embed/
/db/pgdata/
# Zonky embedded-PG extraction scratch (R51-D2: untracked-but-visible in git status)
/db/META-INF/
# user-upload scratch (release tars/zips, working docs). Canonical documents
# live in docs/ — nothing under upload/ belongs in git.
/upload/
# sandbox/orchestration scratch
.scratch/
.initial_snapshot.json
# mini-service build output / logs
mini-services/**/*.out
mini-services/**/*.log
*.out
*.pid

# R65 — orchestration scratch artifacts (verification screenshots etc.) are never repo artifacts
agent-ctx/
dl/
