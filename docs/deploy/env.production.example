# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS production environment — HOST-SIDE interpolation file (T6 of
# docs/deploy/WINDOWS-SERVER-DOCKER-DESKTOP.md).
#
# SEC-ENV-001 (2026-09-15): production secrets are SPLIT PER SERVICE. This
# file is consumed ONLY through `docker compose --env-file .env.production …`
# (build args, composed DATABASE_URL, host port). It is NO LONGER any
# container's runtime env_file — do NOT add runtime secrets here.
#
# Runtime env files — copy and fill each separately (same directory):
#   cp docs/deploy/env.app.production.example    .env.production.app     # app zone
#   cp docs/deploy/env.worker.production.example .env.production.worker  # worker zone
# The provision container needs no env file: compose composes its
# DATABASE_URL, and demo seeding is an explicit -e override of the run
# command (runbook T7).
#
# NO usable secret ships in this repository. Generate every value per
# environment; the startup security policy FAILS production otherwise
# (src/lib/startup/security-policy.ts). Both runtimes also WARN on
# out-of-zone variables at boot (deprecation window; refuses after it).
#
# Never commit the real files (.env* is gitignored; gitleaks runs on every push).
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin (DNS name preferred; a raw LAN IP also passes the
# siteUrl() guard — NEVER localhost / *.local). Baked into the client bundle
# at BUILD time (compose build arg) — changing it later requires an image
# REBUILD, not just a restart.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL superuser password of the compose `postgres` service
# (openssl rand -hex 32 inside WSL2; never commit it). Compose composes the
# app/provision DATABASE_URL from it: postgresql://fayanms:<pw>@postgres:5432/fayanms
POSTGRES_PASSWORD=

# ── Optional compose knobs ───────────────────────────────────────────────────
# Host port published for the app (defaults to 80). Change only if the host
# port is taken; the INTERNAL port 3000 is a hardcoded contract — never change it.
# FAYANMS_HTTP_PORT=80

# ── Internal service URL overrides (runbook T5; defaults shown) ──────────────
# compose.yml wires both hops to the bridge-network DNS names by default —
# uncomment ONLY for a custom topology.
# WORKER_BASE_URL=http://worker:3030   # app → worker (/health, /simulate/*)
# NEXT_BASE_URL=http://app:3000        # worker → app (persistence API)

# ── EXTERNAL PostgreSQL (optional; replaces the compose `postgres` service) ──
# Only set DATABASE_URL explicitly if you point the stack at an EXTERNAL
# PostgreSQL (e.g. a managed instance). It must start with postgresql:// (the
# startup security policy enforces this) and is passed to the app + provision
# containers as compose `environment`, which overrides any env_file value.
# DATABASE_URL=postgresql://user:pass@db.example.corp:5432/fayanms
