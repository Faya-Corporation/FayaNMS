# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS APP runtime environment (SEC-ENV-001 per-service secret split,
# 2026-09-15) — the Next.js application container's env_file.
#
#   cp docs/deploy/env.app.production.example .env.production.app   # then fill
#
# Zone contract (ownership table — SEC-ENV-001):
#   ✓ app zone      session secrets, the config-encryption KEK, the CONTROL
#                   service-identity keypair, proxy/login knobs. DATABASE_URL
#                   is composed by compose from the host-side POSTGRES_PASSWORD
#                   (docs/deploy/env.production.example) — external databases
#                   are also wired from the host-side file, not here.
#   ✗ never here    FAYANMS_VAULT_* device credentials (the WORKER resolves
#                   them — the app stores only vault REFERENCES),
#                   FAYANMS_WEBAPI_CA_PEM, POSTGRES_PASSWORD, NEXT_BASE_URL /
#                   SELF_BASE_URL (worker-plane hops).
# The startup policy warns on out-of-zone variables at boot (deprecation
# window; refuses after it) — see src/lib/startup/security-policy.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Session ──────────────────────────────────────────────────────────────────
# Public origin at RUNTIME — must match the NEXT_PUBLIC_SITE_URL build arg
# from the host-side file (docs/deploy/env.production.example).
NEXTAUTH_URL=http://fayanms.example.corp

# Session secret (openssl rand -hex 32 — inside WSL2). Required, >= 32 chars,
# never a known/demo value (the startup policy enforces this).
NEXTAUTH_SECRET=

# ── Configuration encryption KEK ─────────────────────────────────────────────
# 64 hex chars. Losing it = losing every config-snapshot backup; back it up
# OFF-BOX, separately from the database backups. This key NEVER leaves the
# app — it must not appear in the worker env file.
FAYANMS_CONFIG_ENC_KEY=
FAYANMS_CONFIG_ENC_KEY_ID=k1

# ── Service identity — CONTROL keypair (EdDSA-only production, RECOMMENDED) ──
# Generate with `bun run keys:service` (one run per keypair — the worker env
# file holds the OTHER keypair). THIS file holds the CONTROL keypair:
#   FAYANMS_SERVICE_PRIVATE_KEY = CONTROL private key — the app mints the
#                                 control-plane tokens it sends to the worker
#   FAYANMS_SERVICE_PUBLIC_KEYS = WORKER public keys (comma-separated; old +
#                                 new overlap during rotation) — the app
#                                 verifies incoming worker tokens with them
# With both set and NO FAYANMS_SERVICE_SECRET anywhere, the stack runs
# EdDSA-only: HS256 is structurally impossible and production boots with
# zero symmetric material. See deploy-doc security note 17.
FAYANMS_SERVICE_PRIVATE_KEY=
FAYANMS_SERVICE_PUBLIC_KEYS=
# Optional issuer allowlist for incoming worker tokens
# (fayanms:control,fayanms:worker covers the documented two-plane topology).
# FAYANMS_SERVICE_ISSUERS=

# ── Legacy symmetric plane (MIGRATION/legacy modes ONLY) ─────────────────────
# Leave EMPTY for the recommended EdDSA-only configuration. Required (64 hex)
# only while the Ed25519 keys are not deployed on every process, or during
# the time-boxed dual-verification migration window.
FAYANMS_SERVICE_SECRET=
# Optional: previous service secrets accepted during rotation windows
# (migration/legacy modes only).
FAYANMS_SERVICE_SECRETS=

# ── API rate gate (SAFE-002) + login abuse control (AUTH-001-A) ──────────────
# Trusted reverse-proxy hops in front of the app (0..8, default 1) — keys the
# /api/v1 gate budgets AND the login guard's source keying; keep at your real
# proxy depth. Login knobs (units/defaults/clamped ranges in .env.example):
# FAYANMS_TRUST_PROXY_HOPS=1
# FAYANMS_LOGIN_WINDOW_SECONDS=            # 30..3600, default 300
# FAYANMS_LOGIN_MAX_ATTEMPTS_PER_SOURCE=   # 3..100, default 10
# FAYANMS_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=  # 5..200, default 30

# ── Shared store: API gate + login guard (SCALE-001-A / SCALE-001-B) ─────────
# Budgets are process-local by default (single-host posture). Set "postgres"
# ONLY when running 2+ app instances behind a load balancer — every instance
# then draws from ONE shared budget per plane (the /api/v1 gate AND the login
# guard's throttle/lockout state) in the same database the app already uses.
# Unreachable store fails CLOSED (documented decision).
# FAYANMS_RATE_STORE=memory              # unset | memory | postgres

# ── Ops escape hatch (P2-1) ──────────────────────────────────────────────────
# Prisma query logging is OFF in production; set true ONLY for a bounded
# debugging window (streams SQL to stdout), then remove it again.
# FAYANMS_DB_QUERY_LOG=false

# DATABASE_URL is intentionally NOT set in this file: compose composes it
# from the host-side POSTGRES_PASSWORD (postgresql://fayanms:<pw>@postgres:
# 5432/fayanms) and passes it as container `environment`, which OVERRIDES any
# env_file value. An EXTERNAL PostgreSQL is wired from the host-side file
# (docs/deploy/env.production.example), not here.
