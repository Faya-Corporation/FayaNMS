# ─────────────────────────────────────────────────────────────────────────────
# FayaNMS WORKER runtime environment (SEC-ENV-001 per-service secret split,
# 2026-09-15) — the worker container's env_file.
#
#   cp docs/deploy/env.worker.production.example .env.production.worker  # fill
#
# Zone contract (ownership table — SEC-ENV-001):
#   ✓ worker zone   the WORKER service-identity keypair, the CONTROL public
#                   keys, device vault credentials (FAYANMS_VAULT_*), the
#                   SFOS WebAPI CA pin, worker URL hops.
#   ✗ never here    NEXTAUTH_SECRET / NEXTAUTH_URL (browser sessions are an
#                   app concern), FAYANMS_CONFIG_ENC_KEY(+_ID) (the KEK never
#                   leaves the app), POSTGRES_PASSWORD / DATABASE_URL (the
#                   worker NEVER touches PostgreSQL — all persistence goes
#                   through the app's service-authenticated API), proxy/login/
#                   demo/build knobs.
# The worker warns on out-of-zone variables at boot (deprecation window;
# refuses after it) — see mini-services/worker/identity-boot.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service identity — WORKER keypair (EdDSA-only production, RECOMMENDED) ───
# Generate with `bun run keys:service` (one run per keypair — the app env
# file holds the OTHER keypair). THIS file holds the WORKER keypair:
#   FAYANMS_SERVICE_PRIVATE_KEY = WORKER private key — the worker signs the
#                                 persistence-API tokens the app verifies
#   FAYANMS_SERVICE_PUBLIC_KEYS = CONTROL public keys (comma-separated; old +
#                                 new overlap during rotation) — the worker
#                                 verifies incoming control tokens with them
# With both set and NO FAYANMS_SERVICE_SECRET anywhere, the stack runs
# EdDSA-only. See deploy-doc security note 17.
FAYANMS_SERVICE_PRIVATE_KEY=
FAYANMS_SERVICE_PUBLIC_KEYS=

# ── Legacy symmetric plane (MIGRATION/legacy modes ONLY) ─────────────────────
# Leave EMPTY for the recommended EdDSA-only configuration.
FAYANMS_SERVICE_SECRET=
# Optional: previous service secrets accepted during rotation windows.
FAYANMS_SERVICE_SECRETS=

# ── LIVE_SSH / LIVE_WEBAPI device vault ──────────────────────────────────────
# The app stores only vault REFERENCES (CredentialProfile.secretRef,
# "vault://…"); the WORKER resolves the actual credentials from entries in
# THIS file using the naming rule:
#   vault://ssh/network-admin  →  FAYANMS_VAULT_SSH_NETWORK_ADMIN
#   vault://webapi/sophos-hq   →  FAYANMS_VAULT_WEBAPI_SOPHOS_HQ
# Add one entry per vault reference you intend to use on live devices; rotate
# with the credential (CredentialProfile.lastRotatedAt is the rotation ledger).
# NEVER commit this file.
# FAYANMS_VAULT_SSH_NETWORK_ADMIN=
# FAYANMS_VAULT_WEBAPI_SOPHOS_HQ=

# Vault provider selection (default "env" = the entries above; file/exec exist
# for air-gapped / real-secret-store topologies — deploy-doc security note 16).
# FAYANMS_VAULT_PROVIDER=env
# FAYANMS_VAULT_FILE=
# FAYANMS_VAULT_EXEC=
# FAYANMS_VAULT_EXEC_TIMEOUT_MS=

# ── SFOS WebAPI TLS pin (fail-closed; no verification bypass exists) ─────────
# Optional extra CA/cert for Sophos SFOS endpoints whose chain is not in the
# worker's trust store. A TLS failure refuses the request BEFORE the api-key
# is ever transmitted (deploy-doc security note 18).
# FAYANMS_WEBAPI_CA_PEM=

# ── Worker URL hops (runbook T5; compose defaults shown) ─────────────────────
# Uncomment ONLY for a custom topology.
# NEXT_BASE_URL=http://app:3000        # worker → app (persistence API)
# SELF_BASE_URL=http://localhost:3030  # worker loopback self-calls

# ── Active-probe plane (R50.2/8 — worker-side target policy + budgets) ──────
# The worker re-classifies literal targets AND resolves hostnames (fail-closed
# across the RRset) before any dial; SSH_TARGET_* refusals map to the app's
# stable contract codes. Semantics/defaults: .env.example "Active-probe plane".
# FAYANMS_PROBE_ALLOW_SPECIAL=false         # LAB escape hatch only (audited)
# FAYANMS_WORKER_RESOLVE_TIMEOUT_MS=5000    # hostname resolution wait
# FAYANMS_DETECT_TOTAL_BUDGET_MS=45000      # total detection probe budget
