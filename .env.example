# FayaNMS environment template — P19 security policy (audit SEC-004).
#
# NO usable secret ships in this repository. Generate every value below
# per environment; startup FAILS in production when these rules are violated
# (see src/lib/startup/security-policy.ts):
#   * NEXTAUTH_SECRET            — required, >= 32 chars, never a known/demo value
#   * FAYANMS_CONFIG_ENC_KEY     — required, 64 hex chars (config encryption KEK)
#   * service identity           — Ed25519 keys (RECOMMENDED, boots with no
#                                  shared secret) and/or FAYANMS_SERVICE_SECRET
#                                  (legacy HS256, 64 hex) — see the service
#                                  identity block below for the mode matrix
#   * FAYANMS_DEMO_MODE          — must NOT be "true" in production
#
# Generate secrets:
#   openssl rand -hex 32

# Prisma resolves DATABASE_URL from the environment. Production persistence is
# PostgreSQL (Phase 21 slice 1): the startup security policy REJECTS non-
# postgres URLs when NODE_ENV=production, and compose.yml ships the `postgres`
# service (URL composed from POSTGRES_PASSWORD — see docs/deploy/env.production.example).
#
# Local development: point at any reachable PostgreSQL. The sandbox dev DB is
# an embedded PostgreSQL 16 on port 5433 (db/pg-embed, started by
# .zscripts/postgres.sh ensure). With Docker on any machine:
#   docker run -d --name fayanms-pg -p 5432:5432 \
#     -e POSTGRES_USER=fayanms -e POSTGRES_PASSWORD=fayanms -e POSTGRES_DB=fayanms \
#     postgres:16-alpine
DATABASE_URL="postgresql://fayanms:fayanms@localhost:5433/fayanms"

# Schema provisioning: `bun run db:deploy` replays the committed migration
# history (prisma/migrations) — the production path (compose T7, CI-proven).
# After editing prisma/schema.prisma, land a migration with `bun run db:migrate`
# (prisma migrate dev); CI's drift guard fails any push where the history and
# the schema disagree. `db:push` is a dev-only scratch tool — never production
# (and since P2-3 it is fail-tight: `db:push:force` is the explicit data-loss
# path).

# P2-1 — Prisma query logging. Production defaults to errors+warnings only
# (query text can carry tenant/device payload and is too noisy for steady
# state). Set to "true" ONLY for time-boxed incident debugging; remove it
# afterwards. Development always logs queries.
# FAYANMS_DB_QUERY_LOG=

# NextAuth JWT session signing secret (32-byte hex). LEAVE EMPTY until generated.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Service identity (worker <-> Next job engine) — TASK-SVC-001-A ──────────
#
# THREE supported states, derived from what you configure (a mode switch is
# deliberately NOT used — the configuration itself defines the mode):
#
#   1. EdDSA-only (RECOMMENDED production): configure BOTH key variables
#      below and leave the symmetric secret EMPTY everywhere. HS256 becomes
#      structurally impossible (SERVICE_ALG_REJECTED); whoever holds only
#      public material can authenticate but can never mint. Production
#      startup REQUIRES the app's own private key in this mode — this
#      process mints control-plane tokens and no symmetric fallback exists.
#
#   2. Dual (time-boxed MIGRATION, P1-007 rotation Phase 1): keys AND the
#      shared secret configured. Both algorithms verify; minters prefer
#      EdDSA immediately. The symmetric material is fully strength-checked
#      (64 hex, known-bad blocklist, rotation entries included).
#
#   3. hs256-legacy (DEPRECATED): only the shared secret. Works as before;
#      complete the rotation to reach state 1.
#
# Ownership (two-plane topology — each process holds ONLY its own private
# key and the OTHER side's public key; the one-off provision container
# needs no service identity at all):
#   APP:    FAYANMS_SERVICE_PRIVATE_KEY = CONTROL keypair's private key
#           FAYANMS_SERVICE_PUBLIC_KEYS  = WORKER keypair's public key
#   WORKER: FAYANMS_SERVICE_PRIVATE_KEY = WORKER keypair's private key
#           FAYANMS_SERVICE_PUBLIC_KEYS  = CONTROL keypair's public key
#
# Generate with: bun run keys:service (PKCS8 PEM, escaped newlines
# tolerated, for the private keys; comma-separated SPKI DER base64 for the
# public lists — old and new keys can overlap during rotation).
FAYANMS_SERVICE_PRIVATE_KEY=
FAYANMS_SERVICE_PUBLIC_KEYS=

# Legacy symmetric plane (states 2 and 3 ONLY). LEAVE EMPTY for EdDSA-only.
FAYANMS_SERVICE_SECRET=
# Optional comma list of previous secrets accepted during rotation windows
# (states 2 and 3 only — in EdDSA-only mode any symmetric material is a
# startup-policy violation).
FAYANMS_SERVICE_SECRETS=

# CERT-006 — SFOS WebAPI transport (sophos live plane). The transport's TLS
# verification is ALWAYS on (no bypass flag exists). Default trust anchor is
# the worker's system CA store; devices with private/self-signed certificates
# are enrolled worker-side via a PEM file path (or inline PEM with escaped
# newlines). A TLS failure refuses the request BEFORE the api-key is sent.
# FAYANMS_WEBAPI_CA_PEM=

# Config-snapshot envelope master key (AES-256-GCM KEK). LEAVE EMPTY.
FAYANMS_CONFIG_ENC_KEY=
# Key id stamped into encrypted snapshots (key rotation label), e.g. "k1".
FAYANMS_CONFIG_ENC_KEY_ID=k1

# Demo seeding gate: "true" allows prisma/seed.ts to create shared-credential
# demo users. Refused in production by the startup security policy.
FAYANMS_DEMO_MODE=

# Internal service URLs (runbook T5). Leave UNSET for bare-metal dev — the
# loopback defaults below hold. Compose sets them to the bridge DNS names
# (see docs/deploy/env.production.example).
# WORKER_BASE_URL=http://localhost:3030   # app → worker
# NEXT_BASE_URL=http://localhost:3000     # worker → app

# ── API rate gate (SAFE-002, audit P0-002) ──────────────────────────────────
# Number of trusted reverse-proxy hops in front of the app. The gate keys
# budgets on the X-Forwarded-For entry N hops from the RIGHT (proxies APPEND
# the real client address; leftmost entries are attacker-controlled).
# Default 1 = one proxy (compose Caddy/Nginx). 0 = trust nothing: XFF and
# X-Real-IP are ignored and all callers share one conservative "local" bucket.
# Direct-access deployments with no proxy: leave the default — XFF is absent
# and the "local" bucket applies. Range 0..8.
# FAYANMS_TRUST_PROXY_HOPS=1

# ── Login abuse control (AUTH-001-A, independent audit 2026-09-15) ─────────
# Credential sign-in (POST /api/auth/callback/credentials) is throttled
# BEFORE password verification: sliding-window failed-sign-in budgets per
# source and per targeted account, plus a temporary exponential account
# lockout (30 s·2^n, capped at 4 min — never permanent, decays fully, and a
# successful sign-in resets the state). Units: seconds / attempts; values
# are clamped to the documented ranges (garbage falls back to the default).
# The per-account budget is deliberately HIGHER than the per-source budget
# so a single client alone cannot lock an account (distributed abuse
# required). Keying reuses FAYANMS_TRUST_PROXY_HOPS for the source plus an
# HMAC-keyed hash of the submitted identifier — no raw identifiers or
# passwords are ever stored, logged or emitted. The store is bounded
# in-process memory; a load-balanced deployment needs the SCALE-001-A
# shared store for fleet-wide budgets.
# FAYANMS_LOGIN_WINDOW_SECONDS=            # 30..3600, default 300
# FAYANMS_LOGIN_MAX_ATTEMPTS_PER_SOURCE=   # 3..100, default 10
# FAYANMS_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=  # 5..200, default 30

# ── Shared rate-limit store (SCALE-001-A, independent audit 2026-09-15) ─────
# The /api/v1 rate gate's budgets AND the login guard's budgets/lockouts are
# process-local by default (bounded in-memory; zero-infra single-host). For a
# HORIZONTALLY SCALED app (2+ instances behind a load balancer) set this to
# "postgres" so every instance draws from ONE shared budget per plane —
# per-key advisory-lock-serialized transactions in the SAME database the app
# already uses (no new service; one knob drives BOTH shared planes).
# An unreachable shared store fails CLOSED (documented decision — the DB is
# already a hard dependency; protection is never silently removed).
# FAYANMS_RATE_STORE=memory              # unset | memory | postgres

# ── LIVE_SSH device vault (Phase 22 slice 1 / P1-005, worker-side) ─────────
# The worker resolves CredentialProfile.secretRef references from ITS OWN
# secret backend. FAYANMS_VAULT_PROVIDER selects the backend; references
# never encode one (vault://ssh/network-admin keeps its meaning in all):
#   env  (default) — vault://ssh/network-admin → FAYANMS_VAULT_SSH_NETWORK_ADMIN
#   file           — FAYANMS_VAULT_FILE → JSON {"vault://ssh/network-admin": "…",
#                    "ssh/db-backup": "…", "FAYANMS_VAULT_SSH_…": "…"} (0600!)
#   exec           — FAYANMS_VAULT_EXEC → shell-free argv template whose %s
#                    becomes the raw reference; trimmed stdout is the secret
#                    (e.g. "/usr/local/bin/vault kv get -field=secret %s").
#                    Deadline FAYANMS_VAULT_EXEC_TIMEOUT_MS (default 5000).
# Sandbox harness example (certification driver): FAYANMS_VAULT_SSH_HARNESS.
# FAYANMS_VAULT_PROVIDER=env
# FAYANMS_VAULT_FILE=
# FAYANMS_VAULT_EXEC=
# FAYANMS_VAULT_EXEC_TIMEOUT_MS=5000
# FAYANMS_VAULT_SSH_NETWORK_ADMIN=

# ── Active-probe plane (R50.2/8 — vendor auto-detect + future probes) ───────
# Target network policy (BOTH planes honor it: the app classifies the typed
# literal; the worker re-classifies literals AND the RESOLVED address of a
# hostname before dialing — fail-closed across the RRset):
# FAYANMS_PROBE_ALLOW_SPECIAL=false     # true = LAB escape hatch (audited): re-allows
                                        # special-class targets for SSH/SNMP probes AND discovery subnets (F-038)
# Probe credential allowlist (R50-T021): csv of CredentialProfile ids or
# names that may be used for ACTIVE probing. Unset = every profile usable
# (single-tenant demo posture; the device.detect RBAC gate still bounds who).
# Set = fail-closed — a profile matching no entry is refused
# (CREDENTIAL_NOT_AUTHORIZED) and audited as "profile-not-allowlisted".
# FAYANMS_PROBE_CREDENTIAL_ALLOWLIST=
# Detection budgets (R50-T024; shared store, per minute):
# FAYANMS_DETECT_RATE_LIMIT=20          # per actor
# FAYANMS_DETECT_TARGET_RATE_LIMIT=10   # per target
# Detection time/resource budgets (R50-T025):
# FAYANMS_RESOLVE_TIMEOUT_MS=5000           # app resolver wait (DNS budget)
# FAYANMS_WORKER_RESOLVE_TIMEOUT_MS=5000    # worker resolution wait
# FAYANMS_DETECT_TOTAL_BUDGET_MS=45000      # worker total probe budget
